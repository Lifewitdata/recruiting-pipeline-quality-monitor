# ---------------------------------------------------------------------------
# The source data is third-party personal data and is never committed.
#
# JTH holds pseudonymised records of real job candidates under CC BY-NC 4.0.
# etl/fetch.py re-downloads it and verifies every file against a pinned sha256
# and byte size, so a fresh clone reproduces the exact bytes the README's
# numbers were measured on - without the bytes living in git history.
# ---------------------------------------------------------------------------
data/
*.csv

# Monitor state - regenerate with `python etl/load.py` + `python monitor/cli.py run`.
# A .duckdb file is a single-writer binary; committing it would make every run
# conflict with every other run.
db/
*.duckdb
*.duckdb.wal

# Generated by the tests, the incident harness and the CI gate. The fixture is
# reproducible byte-for-byte (`python etl/synthesize.py` twice, then `cmp`), which
# is exactly what CI asserts, so there is nothing to gain from storing it.
tests/fixtures/
reports/
.gate/
out/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Streamlit: secrets.toml is where a real deployment would put webhook URLs and
# SMTP passwords. The monitor reads its own configuration from the environment
# instead, so this file should never exist here - ignored so it cannot be added
# by accident.
dashboard/.streamlit/secrets.toml
.streamlit/secrets.toml

# Credentials - this project talks to Slack and SMTP only via environment
# variables, never from a committed keyfile.
service-account*.json
*.pem
*.key
credentials.yml
.env
.env.*

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/
